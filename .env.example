JWT_SECRET=
JWT_EXPIRATION_MS=28800000

# MAIL_PROVIDER: smtp (mac dinh) hoac mailjet.
#   Render goi mien phi CHAN cong SMTP di ra (25/465/587) tu 26/09/2025 va ket noi treo
#   den het gio thay vi bao loi. Tren production phai dat MAIL_PROVIDER=mailjet de gui
#   qua API HTTP. Mailjet dung dung cap khoa duoi day cho ca hai duong nen khong can
#   them bien nao khac.
MAIL_PROVIDER=

# Mail. Mac dinh la Gmail; de doi sang nha cung cap khac chi can dat MAIL_HOST/MAIL_PORT.
# Mailjet:  MAIL_HOST=in-v3.mailjet.com  MAIL_PORT=587
#           MAIL_USERNAME = API Key, MAIL_PASSWORD = Secret Key
#           (lay o Account settings -> SMTP and SEND API settings; KHONG phai email
#            va mat khau dang nhap Mailjet — nham cho nay se ra loi Relay Access Denied)
# MAIL_FROM phai la dia chi nguoi gui DA XAC MINH trong tai khoan nha cung cap.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
CLOUDINARY_URL=
