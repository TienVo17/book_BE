JWT_SECRET=
JWT_EXPIRATION_MS=28800000

# Mail. Mac dinh la Gmail; de doi sang nha cung cap khac chi can dat MAIL_HOST/MAIL_PORT.
# Mailjet:  MAIL_HOST=in-v3.mailjet.com  MAIL_PORT=587
#           MAIL_USERNAME = API Key, MAIL_PASSWORD = Secret Key
#           (lay o Account settings -> SMTP and SEND API settings; KHONG phai email
#            va mat khau dang nhap Mailjet — nham cho nay se ra loi Relay Access Denied)
# MAIL_FROM phai la dia chi nguoi gui DA XAC MINH trong tai khoan nha cung cap.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
CLOUDINARY_URL=
